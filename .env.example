# For `docker compose` locally. In Komodo, put these in the stack's Environment.

POSTGRES_PASSWORD=change-me
# Fernet key; encrypts stored ecobee tokens. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# Leave on until you've watched the audit log and agree with what it would send.
DRY_RUN=true

# --- ecobee (dedicated org-owned account that owns every managed thermostat) ---
ECOBEE_USERNAME=facilities@example.org
ECOBEE_PASSWORD=
# Base32 secret shown when you set up the authenticator app on that account
# ("can't scan? enter this key"). Lets the app re-login unattended.
ECOBEE_TOTP_SECRET=

# --- Google Workspace (service account with domain-wide delegation) ---
# The whole JSON key on one line (jq -c . key.json). GOOGLE_SERVICE_ACCOUNT_FILE=path also works.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE=facilities@example.org

# --- Cloudflare (tunnel + Access) ---
TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
ALLOWED_EMAIL_DOMAINS=grace-bible.org
ADMIN_EMAILS=you@example.org

# --- Optional ---
DEFAULT_TIMEZONE=America/Chicago
# Google Chat space → Apps & integrations → Webhooks
GOOGLE_CHAT_WEBHOOK=
